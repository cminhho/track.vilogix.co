{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/TDE/:trackingNumber(IDB2026\\d{4})", "destination": "/index.html" },
    { "source": "/VAE/:trackingNumber(\\d{7})", "destination": "/index.html" }
  ]
}
